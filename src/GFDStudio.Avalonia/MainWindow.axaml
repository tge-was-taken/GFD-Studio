<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GFDStudio.Avalonia"
        xmlns:pg="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
        x:Class="GFDStudio.Avalonia.MainWindow"
        Width="1280" Height="800"
        Background="{DynamicResource WindowBackgroundBrush}">

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="mNewModel" Header="_New model" />
        <MenuItem Name="mOpen" Header="_Open" InputGesture="Ctrl+O" />
        <MenuItem Name="mRecent" Header="Open _recent" />
        <Separator />
        <MenuItem Name="mSave" Header="_Save" InputGesture="Ctrl+S" />
        <MenuItem Name="mSaveAs" Header="Save _as" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Name="mExit" Header="E_xit" />
      </MenuItem>

      <MenuItem Header="_Animation">
        <MenuItem Name="mLoadAnimation" Header="_Load external" />
      </MenuItem>

      <MenuItem Name="mTools" Header="_Tools..." />

      <MenuItem Name="mOptions" Header="_Options..." />

    </Menu>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Name="mStatus" Margin="8,4" Text="Ready" />
    </Border>

    <!-- The viewer takes the left half, with the trees above the properties on the right. -->
    <Grid ColumnDefinitions="*,4,420">

      <DockPanel Grid.Column="0">
        <Border Name="mAnimationControls" DockPanel.Dock="Bottom" IsEnabled="False"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="8" ColumnSpacing="8">
            <Slider Name="mAnimationTime" Grid.Column="0" Minimum="0" Maximum="1000"
                    VerticalAlignment="Center" />
            <Button Name="mPlayPause" Grid.Column="1" Content="&#x25B6;" MinWidth="80" />
            <Button Name="mStop" Grid.Column="2" Content="&#x25A0;" MinWidth="80" />
          </Grid>
        </Border>

        <Panel Background="{DynamicResource ViewportBackgroundBrush}">
          <local:ModelView Name="mModelView" IsVisible="False" />

          <DockPanel Name="mTexturePanel" IsVisible="False">
            <Border DockPanel.Dock="Top" Padding="8,4"
                    Background="{DynamicResource PanelBackgroundBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Name="mTextureSize" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ToggleButton Name="mChannelR" Content="R" IsChecked="True" MinWidth="34" />
                <ToggleButton Name="mChannelG" Content="G" IsChecked="True" MinWidth="34" />
                <ToggleButton Name="mChannelB" Content="B" IsChecked="True" MinWidth="34" />
                <ToggleButton Name="mChannelA" Content="A" IsChecked="True" MinWidth="34" />
                <Button Name="mTextureReset" Content="1:1" MinWidth="40" Margin="8,0,0,0"
                        ToolTip.Tip="Show the texture at its own size" />
              </StackPanel>
            </Border>

            <local:TextureView Name="mTextureView" />
          </DockPanel>
        </Panel>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="3*,4,4*">
        <TabControl Grid.Row="0">
          <TabItem Header="Model Editor">
            <local:DataViewNodeTree Name="mTree" />
          </TabItem>
          <TabItem Header="Animation List">
            <local:DataViewNodeTree Name="mAnimationTree" />
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

        <pg:PropertyGrid Grid.Row="2" Name="mProperties"
                         IsTitleVisible="False" IsQuickFilterVisible="True" />
      </Grid>

    </Grid>

  </DockPanel>
</Window>
