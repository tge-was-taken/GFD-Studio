<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GFDStudio.Avalonia</RootNamespace>
    <AssemblyName>GFDStudio</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_data\icons\main_icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="bodong.Avalonia.PropertyGrid" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GFDLibrary.Rendering.OpenGL\GFDLibrary.Rendering.OpenGL.csproj" />
    <ProjectReference Include="..\GFDStudio.Core\GFDStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app_data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Presets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
