<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GFDLibrary</AssemblyName>
    <RootNamespace>GFDLibrary</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>TRACE;NET5</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Animations\Conversion\" />
  </ItemGroup>

  <!-- The DirectXTex codecs live in a native library built by GFDLibrary.Native.DirectXTex. A local
       CMake build lands in its out directory; CI publishes per runtime binaries instead. Point
       DirectXTexCNativeDir elsewhere to use a build from another location. -->
  <PropertyGroup>
    <DirectXTexCNativeDir Condition="'$(DirectXTexCNativeDir)' == ''">$(MSBuildThisFileDirectory)..\native\GFDLibrary.Native.DirectXTex\out</DirectXTexCNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(DirectXTexCNativeDir)\DirectXTexC.dll" Condition="Exists('$(DirectXTexCNativeDir)\DirectXTexC.dll')"
          Link="DirectXTexC.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DirectXTexCNativeDir)\DirectXTexC.so" Condition="Exists('$(DirectXTexCNativeDir)\DirectXTexC.so')"
          Link="DirectXTexC.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DirectXTexCNativeDir)\DirectXTexC.dylib" Condition="Exists('$(DirectXTexCNativeDir)\DirectXTexC.dylib')"
          Link="DirectXTexC.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The FBX exporter reaches the Autodesk FBX SDK through a native library built by
       GFDLibrary.Native.FbxSdk. The SDK is a licensed download, so this one is often absent; the
       exporter then fails at runtime instead of breaking the build. -->
  <PropertyGroup>
    <FbxSdkCNativeDir Condition="'$(FbxSdkCNativeDir)' == ''">$(MSBuildThisFileDirectory)..\native\GFDLibrary.Native.FbxSdk\out</FbxSdkCNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(FbxSdkCNativeDir)\FbxSdkC.dll" Condition="Exists('$(FbxSdkCNativeDir)\FbxSdkC.dll')"
          Link="FbxSdkC.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FbxSdkCNativeDir)\FbxSdkC.so" Condition="Exists('$(FbxSdkCNativeDir)\FbxSdkC.so')"
          Link="FbxSdkC.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FbxSdkCNativeDir)\FbxSdkC.dylib" Condition="Exists('$(FbxSdkCNativeDir)\FbxSdkC.dylib')"
          Link="FbxSdkC.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
