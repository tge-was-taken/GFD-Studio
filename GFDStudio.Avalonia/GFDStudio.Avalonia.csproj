<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GFDStudio.Avalonia</RootNamespace>
    <AssemblyName>GFDStudio</AssemblyName>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc</VersionSuffix>
    <Authors>TGE</Authors>
    <Company>TGE</Company>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_data\icons\main_icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="bodong.Avalonia.PropertyGrid" Version="12.1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GFDLibrary.Rendering.OpenGL\GFDLibrary.Rendering.OpenGL.csproj" />
    <ProjectReference Include="..\GFDStudio.Core\GFDStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app_data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Presets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
