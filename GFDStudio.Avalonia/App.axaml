<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GFDStudio.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- Fluent sizes tab headers for touch, which is far too large for a tool window. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Property names are often longer than the column, so let them wrap rather than clip. -->
    <Style Selector="TextBlock.property-name">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- The greys the WinForms front end used: a flat dark chrome with the lighter
             viewport the renderer clears to. -->
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAltHighColor">#1E1E1E</Color>
          <Color x:Key="SystemAltMediumHighColor">#1E1E1E</Color>
          <Color x:Key="SystemChromeLowColor">#2A2A2A</Color>
          <Color x:Key="SystemChromeMediumLowColor">#252525</Color>
          <Color x:Key="SystemChromeMediumColor">#2A2A2A</Color>
          <Color x:Key="SystemListLowColor">#2A2A2A</Color>
          <Color x:Key="SystemListMediumColor">#333333</Color>
          <Color x:Key="SystemBaseHighColor">#DCDCDC</Color>

          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252525" />
          <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#3C3F41" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#3C3F41" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
