<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GFDLibrary\GFDLibrary.csproj" />
  </ItemGroup>

  <!-- The tests read game assets that are not in the repository. Drop them in Resources/TestData
       and they land where the tests look for them. -->
  <ItemGroup>
    <Content Include="..\..\Resources\TestData\**\*" LinkBase="resources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
